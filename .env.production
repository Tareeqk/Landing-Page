VITE_BASE_URL=https://platform.tareeqk.ae
# Cloudflare Turnstile site key (public) -- pairs with TURNSTILE_SECRET_KEY
# on the backend. Must be filled in for production: without it the widget
# never renders, so captcha_token is always sent empty and the backend's
# own "required" rule rejects every partner-application submission (see
# PartnerForm.jsx) -- fails closed, not open.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFKAsoKpf2XDUEU2
